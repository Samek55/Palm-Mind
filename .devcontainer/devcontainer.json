{
  "name": "palm-mind-rag",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-dev.txt",
  "forwardPorts": [8000, 6333],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
