# --- LLM -------------------------------------------------------------
# free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# --- Redis (chat memory) ----------------------------------------------
# local: redis://localhost:6379/0
# Redis Cloud: redis://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vectors) -------------------------------------------------
# Leave QDRANT_URL empty to use embedded on-disk Qdrant (./data/qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- SQL (document metadata + bookings) --------------------------------
# e.g. postgresql+psycopg://user:pass@localhost:5432/rag (install psycopg)
DATABASE_URL=sqlite:///./data/app.db

# --- Tuning ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FIXED_CHUNK_SIZE=200
FIXED_CHUNK_OVERLAP=40
SEMANTIC_SIMILARITY_THRESHOLD=0.55
SEMANTIC_MAX_CHUNK_WORDS=300
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
